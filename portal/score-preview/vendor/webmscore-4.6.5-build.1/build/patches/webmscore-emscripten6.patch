+# The QGuiApplication runs on the offscreen platform (main.cpp), not Qt's browser one
+qt_import_plugins(webmscore INCLUDE_BY_TYPE platforms Qt6::QOffscreenIntegrationPlugin)
+
 target_include_directories(webmscore PUBLIC
     ${MU_ROOT} # for thirdparty/
