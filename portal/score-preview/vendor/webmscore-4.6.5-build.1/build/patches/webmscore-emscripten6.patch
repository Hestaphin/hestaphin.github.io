--- a/web/CMakeLists.txt
+++ b/web/CMakeLists.txt
@@ -81,8 +81,10 @@ set(WASM_LINK_FLAGS         "${WASM_LINK_FLAGS} -s ALLOW_TABLE_GROWTH=1")
 set(WASM_LINK_FLAGS         "${WASM_LINK_FLAGS} -s ALLOW_MEMORY_GROWTH=1")
